{
    // Staat in de hoofdmap, zodat ook de GitHub-koppeling van Cloudflare (Workers Builds) deze
    // config gebruikt en niet de public/-map als statische site neerzet.
    // Handmatig deployen vanuit de hoofdmap: npx wrangler deploy
    "name": "tripcrew",
    "main": "cloudflare/worker.js",
    "compatibility_date": "2026-09-01",
    "workers_dev": true,
    "vars": {
        // Verandert bij elke herstart van een quick tunnel (trycloudflare.com).
        "ORIGIN": "https://crown-analog-bald-ecological.trycloudflare.com"
    }
}
